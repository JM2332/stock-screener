rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Single-user personal tool, no auth — scoped to exactly these two
    // documents (a list of tickers, and price-alert thresholds — neither
    // sensitive) rather than opening the whole database. Everything else
    // stays default-denied.
    match /watchlist/main {
      allow read, write: if true;
    }
    match /alerts/main {
      allow read, write: if true;
    }
    match /pushSubscriptions/main {
      allow read, write: if true;
    }
  }
}
